# Public domains. Point these DNS records to the Hostinger VPS public IP.
APP_DOMAIN=example.com
API_DOMAIN=api.example.com
WS_DOMAIN=ws.example.com
ACME_EMAIL=admin@example.com

# Database
POSTGRES_DB=aoweb
POSTGRES_USER=aoweb
POSTGRES_PASSWORD=change-this-postgres-password

# Shared internal token used by API, frontend server routes, and game server.
TOKEN_AUTH=change-this-token-auth

# API
CORS_ORIGIN=https://example.com
GAME_DATA_ADMIN_EMAIL=
GAME_DATA_ADMIN_ACCOUNT_ID=
GAME_DATA_ADMIN_PROXY_TOKEN=

# Donaciones (NOWPayments - https://nowpayments.io)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# El método cripto está apagado por defecto; poner true para volver a mostrarlo.
DONATIONS_CRYPTO_ENABLED=false

# Donaciones con tarjeta (MoonPay - https://dashboard.moonpay.com)
# Claves pk_test_/sk_test_ usan el sandbox; las pk_live_/sk_live_ requieren KYB aprobado.
# MOONPAY_WALLET_ADDRESS es la wallet propia que recibe la cripto (debe ser válida para MOONPAY_CURRENCY_CODE).
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_KEY=
MOONPAY_WALLET_ADDRESS=
MOONPAY_CURRENCY_CODE=usdc_polygon

# Game server
RESET_CONNECTED_CHARACTERS_ON_STARTUP=true
INITIAL_ONLINE_RECORD=0

# Frontend
NEXT_PUBLIC_AOWEB_TEST_MODE=false
NEXT_BUILD_ID=
